{
  "name": "cryptowave-monorepo",
  "private": true,
  "packageManager": "bun@1.3.9",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "bun test packages/*/src apps/*/src",
    "lint": "bun run check-types",
    "check-types": "tsc --noEmit",
    "generate-samples": "bun run scripts/generate-sample.ts",
    "demo": "bun run scripts/demo.ts",
    "cli": "bun run scripts/cli.ts",
    "encode": "bun run scripts/cli.ts encode",
    "decode": "bun run scripts/cli.ts decode",
    "analyze": "bun run scripts/cli.ts analyze"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^22.0.0",
    "lucide-react": "^1.47.0",
    "turbo": "^2.4.0",
    "typescript": "^5.7.0"
  }
}
